# Endereços públicos
PUBLIC_WEB_URL=https://flores.example.com
PUBLIC_API_URL=https://api.flores.example.com/api
# Origem do backend sem o sufixo /api. Na Vercel permite encaminhar /api no mesmo domínio.
BACKEND_ORIGIN=https://api.flores.example.com
WEB_DOMAIN=flores.example.com
API_DOMAIN=api.flores.example.com
TLS_EMAIL=admin@example.com

# Base de dados do compose
POSTGRES_DB=momentos
POSTGRES_USER=momentos
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Backend
JWT_SECRET=replace-with-at-least-32-random-characters
COOKIE_SAME_SITE=none
COOKIE_DOMAIN=
STRIPE_SECRET_KEY=sk_live_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
GOOGLE_MAPS_API_KEY=replace
RESEND_API_KEY=re_replace
RESEND_FROM_EMAIL=Momentos em Flor <onboarding@resend.dev>
RESEND_REPLY_TO_EMAIL=
# Manter vazio depois de verificar o domínio. Durante o onboarding pode receber um email autorizado.
RESEND_RECIPIENT_OVERRIDE=
RESEND_BRAND_LOGO_URL=https://flores.example.com/logo.svg
RESEND_TEMPLATE_PASSWORD_RESET=password-reset
RESEND_TEMPLATE_EMAIL_VERIFICATION=confirm-email
RESEND_TEMPLATE_ORDER_OFFER_CREATED=new-order-offer
RESEND_TEMPLATE_INVOICE_ISSUED=invoice-available
RESEND_TEMPLATE_ORDER_OUT_FOR_DELIVERY=order-out-for-delivery
RESEND_TEMPLATE_ORDER_DELIVERY_CONFIRMATION=order-delivery-confirmation
SUPABASE_URL=https://replace.supabase.co
SUPABASE_SECRET_KEY=replace
# Um bucket por ambiente: dev, test ou prod.
SUPABASE_BUCKET=
MOLONI_ENCRYPTION_KEY=replace-with-32-byte-base64-key
DEFAULT_DELIVERY_FEE=5
DEFAULT_DELIVERY_RADIUS_KM=15
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password
BOOTSTRAP_ADMIN_PHONE=+351912345678
BOOTSTRAP_ADMIN_FIRST_NAME=Administrador
BOOTSTRAP_ADMIN_LAST_NAME=Momentos em Flor

# Frontend (incorporadas durante o build)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_replace
# Em Vercel usar /api para evitar cookies cross-site. Em Docker pode manter PUBLIC_API_URL.
NEXT_PUBLIC_FILES_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Identificação legal — preencher antes de disponibilizar ao público
NEXT_PUBLIC_LEGAL_ENTITY=
NEXT_PUBLIC_LEGAL_NIF=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_PRIVACY_EMAIL=
NEXT_PUBLIC_RAL_NAME=
NEXT_PUBLIC_RAL_URL=
NEXT_PUBLIC_BOOK_OF_COMPLAINTS_URL=https://www.livroreclamacoes.pt/Inicio/
