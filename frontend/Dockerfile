FROM node:22-alpine AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci

FROM node:22-alpine AS builder
WORKDIR /app
COPY --from=dependencies /app/node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_FILES_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_CONTACT_EMAIL
ARG NEXT_PUBLIC_CONTACT_PHONE
ARG NEXT_PUBLIC_INSTAGRAM_URL
ARG NEXT_PUBLIC_FACEBOOK_URL
ARG NEXT_PUBLIC_HOME_HERO
ARG NEXT_PUBLIC_HOME_STORE_VIDEO
ARG NEXT_PUBLIC_HOME_STORE_IMAGE
ARG NEXT_PUBLIC_HOME_MOMENT_BIRTHDAY
ARG NEXT_PUBLIC_HOME_MOMENT_LOVE
ARG NEXT_PUBLIC_HOME_MOMENT_WEDDING
ARG NEXT_PUBLIC_HOME_MOMENT_NEW_BABY
ARG NEXT_PUBLIC_HOME_MOMENT_THANK_YOU
ARG NEXT_PUBLIC_HOME_MOMENT_FUNERAL
ARG NEXT_PUBLIC_BLOG_PATRICIA_IMAGE
ARG NEXT_PUBLIC_BLOG_OCCASIONS_IMAGE
ARG NEXT_PUBLIC_BLOG_FLOWER_CARE_IMAGE
ARG NEXT_PUBLIC_LEGAL_ENTITY
ARG NEXT_PUBLIC_LEGAL_NIF
ARG NEXT_PUBLIC_LEGAL_ADDRESS
ARG NEXT_PUBLIC_PRIVACY_EMAIL
ARG NEXT_PUBLIC_RAL_NAME
ARG NEXT_PUBLIC_RAL_URL
ARG NEXT_PUBLIC_BOOK_OF_COMPLAINTS_URL
ARG BACKEND_ORIGIN
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_FILES_URL=$NEXT_PUBLIC_FILES_URL
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ENV NEXT_PUBLIC_CONTACT_EMAIL=$NEXT_PUBLIC_CONTACT_EMAIL
ENV NEXT_PUBLIC_CONTACT_PHONE=$NEXT_PUBLIC_CONTACT_PHONE
ENV NEXT_PUBLIC_INSTAGRAM_URL=$NEXT_PUBLIC_INSTAGRAM_URL
ENV NEXT_PUBLIC_FACEBOOK_URL=$NEXT_PUBLIC_FACEBOOK_URL
ENV NEXT_PUBLIC_HOME_HERO=$NEXT_PUBLIC_HOME_HERO
ENV NEXT_PUBLIC_HOME_STORE_VIDEO=$NEXT_PUBLIC_HOME_STORE_VIDEO
ENV NEXT_PUBLIC_HOME_STORE_IMAGE=$NEXT_PUBLIC_HOME_STORE_IMAGE
ENV NEXT_PUBLIC_HOME_MOMENT_BIRTHDAY=$NEXT_PUBLIC_HOME_MOMENT_BIRTHDAY
ENV NEXT_PUBLIC_HOME_MOMENT_LOVE=$NEXT_PUBLIC_HOME_MOMENT_LOVE
ENV NEXT_PUBLIC_HOME_MOMENT_WEDDING=$NEXT_PUBLIC_HOME_MOMENT_WEDDING
ENV NEXT_PUBLIC_HOME_MOMENT_NEW_BABY=$NEXT_PUBLIC_HOME_MOMENT_NEW_BABY
ENV NEXT_PUBLIC_HOME_MOMENT_THANK_YOU=$NEXT_PUBLIC_HOME_MOMENT_THANK_YOU
ENV NEXT_PUBLIC_HOME_MOMENT_FUNERAL=$NEXT_PUBLIC_HOME_MOMENT_FUNERAL
ENV NEXT_PUBLIC_BLOG_PATRICIA_IMAGE=$NEXT_PUBLIC_BLOG_PATRICIA_IMAGE
ENV NEXT_PUBLIC_BLOG_OCCASIONS_IMAGE=$NEXT_PUBLIC_BLOG_OCCASIONS_IMAGE
ENV NEXT_PUBLIC_BLOG_FLOWER_CARE_IMAGE=$NEXT_PUBLIC_BLOG_FLOWER_CARE_IMAGE
ENV NEXT_PUBLIC_LEGAL_ENTITY=$NEXT_PUBLIC_LEGAL_ENTITY
ENV NEXT_PUBLIC_LEGAL_NIF=$NEXT_PUBLIC_LEGAL_NIF
ENV NEXT_PUBLIC_LEGAL_ADDRESS=$NEXT_PUBLIC_LEGAL_ADDRESS
ENV NEXT_PUBLIC_PRIVACY_EMAIL=$NEXT_PUBLIC_PRIVACY_EMAIL
ENV NEXT_PUBLIC_RAL_NAME=$NEXT_PUBLIC_RAL_NAME
ENV NEXT_PUBLIC_RAL_URL=$NEXT_PUBLIC_RAL_URL
ENV NEXT_PUBLIC_BOOK_OF_COMPLAINTS_URL=$NEXT_PUBLIC_BOOK_OF_COMPLAINTS_URL
ENV BACKEND_ORIGIN=$BACKEND_ORIGIN
RUN npm run build

FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
