generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum ProductType {
  SALE
  RENTAL
}

enum OrderItemType {
  PRODUCT
  DELIVERY_FEE
}

enum UserRole {
  SYSTEM_ADMIN
  FLORIST
  CUSTOMER
}

enum FileProvider {
  LOCAL
  S3
  AZURE
  CLOUDINARY
}

enum PricingMarginType {
  FIXED_AMOUNT
  PERCENTAGE
  FIXED_PRICE
}

enum PaymentStatus {
    PENDING
    PAID
    FAILED
    CANCELLED
    REFUNDED
}

//
// PRODUCT VARIANT TYPE
//
// For now we only support SIZE.
//
// Future examples could be:
// COLOR
// STYLE
// FLOWER_TYPE
// PACKAGING
//

enum ProductVariantType {
  SIZE
}

enum OrderStatus {
  CREATED
  PENDING_PAYMENT
  WAITING_FOR_FLORISTS
  ASSIGNED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryTimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum Occasion {
  BIRTHDAY
  ANNIVERSARY
  LOVE
  WEDDING
  FUNERAL
  NEW_BABY
  MOTHERS_DAY
  FATHERS_DAY
  CHRISTMAS
  OTHER
}

enum OrderCancellationReason {
  NO_FLORIST_AVAILABLE
  CUSTOMER_REQUEST
  ADMIN_REQUEST
  PAYMENT_FAILED
  OTHER
}

enum OrderOfferStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum ReviewCategory {
  FLOWER_QUALITY
  PRESENTATION
  DELIVERY
  SERVICE
}

//
// CATEGORY
//

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  slug        String    @unique
  description String?
  active      Boolean   @default(true)

  products    Product[] @relation("ProductCategories")

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([active])
}

//
// FLORIST
//

model Florist {
  id Int @id @default(autoincrement())

  name      String
  legalName String?

  taxNumber String @unique

  email String @unique
  phone String

  website     String?
  description String?

  active          Boolean @default(true)
  acceptingOrders Boolean @default(true)

  addressStreet  String
  addressStreetNumber String
  addressStreet2 String?
  addressPostalCode  String
  addressCity        String
  addressDistrict    String
  addressCountryCode String @db.Char(2)
  addressLatitude  Decimal? @db.Decimal(9, 6)
  addressLongitude Decimal? @db.Decimal(9, 6)

  deliveryRadiusKm Decimal @db.Decimal(5, 2)

  users User[]

  orderOffers                       OrderOffer[]
  orderReviews                      OrderReview[]
  assignedOrders                    Order[]                            @relation("OrderAssignedFlorist")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([acceptingOrders])
}

//
// USER
//

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  tokenHash String   @unique
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String

  email        String @unique
  passwordHash String

  phone String
  taxNumber String?

  role UserRole

  active        Boolean @default(true)
  emailVerified Boolean @default(false)

  lastLoginAt DateTime?

  refreshTokens RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  floristId Int?
  florist   Florist? @relation(fields: [floristId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  orderReviews       OrderReview[]

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([active])
}

//
// REFRESH TOKEN
//

model RefreshToken {
  id Int @id @default(autoincrement())

  tokenId   String @unique
  tokenHash String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

//
// TAX CODE
//

model TaxCode {
  id Int @id @default(autoincrement())

  name String @unique
  description String

  rate Decimal @db.Decimal(5, 2)

  active Boolean @default(true)

  products Product[]
  orderItems OrderItem[]
  orderTaxTotals OrderTaxTotal[]

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  

  @@index([active])
}

//
// PRODUCT
//

model Product {
  id Int @id @default(autoincrement())

  name        String @unique
  slug        String @unique
  description String?

  active        Boolean     @default(true)
  type          ProductType @default(SALE)
  featured      Boolean     @default(false)
  rentalDeposit Decimal?    @db.Decimal(10, 2)

  customerPrice Decimal @db.Decimal(10, 2)
  floristPrice  Decimal @db.Decimal(10, 2)

  //
  // TAX
  //

  taxCodeId Int
  taxCode   TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  //
  // CATEGORY
  //

  categories Category[] @relation("ProductCategories")

  /**
   * A product can have:
   * - zero components and zero variants
   * - components and no variants
   * - variants and no components
   * Components + variants are mutually exclusive
   * and must be validated by the service layer.
   */
  components ProductComponent[]
  variants   ProductVariant[]

  /**
   * Product images.
   * An image can be:
   * - product-wide: variantId = null
   * - variant-specific: variantId != null
   */
  images ProductImage[]

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@index([taxCodeId])
}

//
// PRODUCT COMPONENT
//

model ProductComponent {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  //
  // Component name.
  //
  // Examples:
  // - Rosas
  // - Peónias
  // - Eucalipto
  //

  name String

  //
  // Quantity rules
  //

  minQuantity         Int
  recommendedQuantity Int
  maxQuantity         Int

  customerPricePerAdditionalUnit Decimal @db.Decimal(10, 2)
  floristPricePerAdditionalUnit Decimal @db.Decimal(10, 2)

  sortOrder Int @default(0)

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, name])
  @@index([productId])
  @@index([active])
}

//
// PRODUCT VARIANT
//

model ProductVariant {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  /**
   * Variant type.
   * Currently:
   * - SIZE
   * Future examples:
   * - COLOR
   * - STYLE
   * - FLOWER_TYPE
   * - PACKAGING
   */

  type ProductVariantType

  /**
   * Human-readable variant name.
   * Examples:
   * - Pequena
   * - Média
   * - Grande
   */

  name String

  description String

  customerPrice Decimal @db.Decimal(10, 2)
  floristPrice  Decimal @db.Decimal(10, 2)


  sortOrder Int @default(0)

  active Boolean @default(true)

  imagePath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, type, name])
  @@index([productId])
  @@index([type])
  @@index([active])
}

//
// PRODUCT IMAGE
//


model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int
  path      String   @unique
  isPrimary Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId],references: [id],onDelete: Cascade)

  @@index([productId])
}


//
// ORDER
//

model Order {
  id Int @id @default(autoincrement())

  //
  // Identification
  //

  orderNumber String @unique

  //
  // Customer
  //

  customerId Int?
  customer   User? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedFloristId Int?
  assignedFlorist   Florist? @relation("OrderAssignedFlorist", fields: [assignedFloristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  customerFirstName String
  customerLastName  String
  customerEmail     String
  customerPhone     String
  customerTaxNumber String?

  //
  // Recipient
  //

  recipientFirstName String
  recipientLastName  String?
  recipientPhone     String?

  occasion Occasion?

  //
  // Delivery
  //

  deliveryDate         DateTime
  deliveryTimeSlot     DeliveryTimeSlot
  deliveryInstructions String?

  //
  // Delivery Address Snapshot
  //

  deliveryStreet  String
  deliveryStreetNumber String
  deliveryStreet2 String?

  deliveryPostalCode  String
  deliveryCity        String
  deliveryDistrict    String
  deliveryCountryCode String @db.Char(2)

  deliveryLatitude  Decimal? @db.Decimal(9, 6)
  deliveryLongitude Decimal? @db.Decimal(9, 6)

  //
  // Card
  //

  cardMessage String?

  //
  // Internal notes
  //

  notes String?

  review OrderReview?

  subtotal    Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  payment Payment?


  status OrderStatus @default(CREATED)

  //
  // Relations
  //

  items         OrderItem[]
  offers        OrderOffer[]
  taxTotals OrderTaxTotal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedAt DateTime?

  cancelledAt        DateTime?
  cancellationReason OrderCancellationReason?

  @@index([customerId])
  @@index([assignedFloristId])
  @@index([status])
  @@index([deliveryDate])
}

//
// ORDER ITEM
//

//
// ORDER ITEM
//

model OrderItem {
  id Int @id @default(autoincrement())

  //
  // Order
  //

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  //
  // Product
  //
  // Nullable because the item can be a custom product
  // that does not exist in the catalog.
  //

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  type OrderItemType @default(PRODUCT)

  //
  // Product snapshot
  //

  name        String
  description String?
  imagePath String?

  //
  // Selected variant snapshot
  //

  variantId   Int?
  variantType ProductVariantType?
  variantName String?

  //
  // Components
  //

  components OrderItemComponent[]

  //
  // Quantity
  //

  quantity Int

  //
  // Financial snapshot
  //
  customerPrice Decimal @db.Decimal(10, 2)
  floristPrice  Decimal @db.Decimal(10, 2)

  netAmount   Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  grossAmount Decimal @db.Decimal(10, 2)

  //
  // Tax code snapshot/reference
  //

  taxCodeId Int?
  taxCode   TaxCode? @relation(fields: [taxCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  taxRate    Decimal? @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@index([taxCodeId])
}

//
// ORDER ITEM COMPONENT
//

model OrderItemComponent {
  id Int @id @default(autoincrement())

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  componentId Int

  // Snapshot
  componentName String

  quantity        Int
  additionalUnits Int

  customerPricePerAdditionalUnit Decimal @db.Decimal(10, 2)
  customerTotalPrice             Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderItemId, componentId])
  @@index([componentId])
}



//
// ORDER OFFER
//

//
// ORDER OFFER
//

model OrderOffer {
  id Int @id @default(autoincrement())

  //
  // Order
  //

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  //
  // Florist
  //

  floristId Int
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  //
  // Financial snapshot
  //

  price Decimal @db.Decimal(10, 2)

  //
  // Workflow
  //

  status OrderOfferStatus @default(PENDING)

  distanceKm Decimal @db.Decimal(8, 2)

  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?
  expiresAt  DateTime

  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([floristId])
  @@index([status])
  @@index([expiresAt])
}

//
// ORDER REVIEW
//

model OrderReview {
  id Int @id @default(autoincrement())

  orderId Int   @unique
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  customerId Int
  customer   User @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  floristId Int
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  comment String?

  ratings OrderReviewRating[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// ORDER REVIEW RATING
//

model OrderReviewRating {
  id Int @id @default(autoincrement())

  reviewId Int
  review   OrderReview @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  category ReviewCategory

  rating Int

  createdAt DateTime @default(now())

  @@unique([reviewId, category])
}

model StoreSettings {
  id          Int      @id @default(1)
  deliveryFee Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Payment {
    id                    Int           @id @default(autoincrement())

    orderId               Int           @unique
    order                 Order         @relation(fields: [orderId], references: [id])

    status                PaymentStatus @default(PENDING)

    amount                Decimal       @db.Decimal(10, 2)
    currency              String        @default("EUR")

    stripeSessionId       String?       @unique
    stripePaymentIntentId String?       @unique

    paidAt                DateTime?

    createdAt             DateTime      @default(now())
    updatedAt             DateTime      @updatedAt

    @@index([status])
}

model OrderTaxTotal {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  taxCodeId Int
  taxCode   TaxCode @relation(fields: [taxCodeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  netAmount   Decimal @db.Decimal(10, 2)
  taxAmount   Decimal @db.Decimal(10, 2)
  grossAmount Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, taxCodeId])
  @@index([orderId])
  @@index([taxCodeId])
}
