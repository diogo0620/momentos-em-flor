generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum UserRole {
  SYSTEM_ADMIN
  FLORIST
  CUSTOMER
}

enum FileProvider {
  LOCAL
  S3
  AZURE
  CLOUDINARY
}

enum ProductPricingType {
  FIXED
  PER_UNIT
}

enum PricingMarginType {
  FIXED_AMOUNT
  PERCENTAGE
  FIXED_PRICE
}

//
// MODELS
//

model Category {
  id Int @id @default(autoincrement())

  name        String
  slug        String
  description String?

  active Boolean @default(true)

  products Product[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sortOrder Int @default(0)

  @@index([active])
  @@index([deletedAt])
}

model Address {
  id Int @id @default(autoincrement())

  street  String
  street2 String?

  postalCode  String
  city        String
  district    String
  countryCode String @db.Char(2)

  latitude  Decimal @db.Decimal(9, 6)
  longitude Decimal @db.Decimal(9, 6)

  notes String?

  florist Florist?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postalCode])
  @@index([city])
  @@index([deletedAt])
}

model Florist {
  id Int @id @default(autoincrement())

  name      String
  legalName String?

  taxNumber String @unique

  email String @unique
  phone String

  website     String?
  description String?

  active          Boolean @default(true)
  acceptingOrders Boolean @default(true)

  deliveryRadiusKm Decimal @db.Decimal(5, 2)

  addressId Int     @unique
  address   Address @relation(fields: [addressId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  users User[]

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  orderOffers              OrderOffer[]
  floristCompensationRules FloristCompensationRule[]

  assignedOrders Order[] @relation("OrderAssignedFlorist")

  @@index([active])
  @@index([acceptingOrders])
  @@index([deletedAt])
}

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName  String

  email        String @unique
  passwordHash String

  phone String?

  avatarUrl String?

  role UserRole

  active        Boolean @default(true)
  emailVerified Boolean @default(false)

  lastLoginAt   DateTime?
  refreshTokens RefreshToken[]

  floristId Int?
  florist   Florist? @relation(fields: [floristId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  orderStatusHistory OrderStatusHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  orders    Order[]

  @@index([role])
  @@index([active])
  @@index([deletedAt])
}

model RefreshToken {
  id Int @id @default(autoincrement())

  tokenId   String @unique
  tokenHash String

  userId Int
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model File {
  id Int @id @default(autoincrement())

  originalName String
  storedName   String

  extension String
  mimeType  String

  size Int

  path String

  checksum String? @unique

  width  Int?
  height Int?

  altText String?

  provider FileProvider

  uploadedAt DateTime  @default(now())
  deletedAt  DateTime?

  @@index([deletedAt])
}

model Product {
  id Int @id @default(autoincrement())

  name        String
  slug        String
  description String?

  active Boolean @default(true)

  pricingType ProductPricingType

  // Default price before florist adjustments
  basePrice Decimal @db.Decimal(10, 2)

  baseFloristCompensation Decimal @db.Decimal(10, 2)

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sortOrder Int @default(0)

  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  orderItems               OrderItem[]
  floristCompensationRules FloristCompensationRule[]

  @@index([active])
  @@index([deletedAt])
  @@index([categoryId])
}

enum OrderStatus {
  CREATED
  WAITING_FOR_FLORISTS
  ASSIGNED
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum DeliveryTimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum Occasion {
  BIRTHDAY
  ANNIVERSARY
  LOVE
  WEDDING
  FUNERAL
  NEW_BABY
  MOTHERS_DAY
  FATHERS_DAY
  CHRISTMAS
  OTHER
}

enum OrderCancellationReason {
  NO_FLORIST_AVAILABLE
  CUSTOMER_REQUEST
  ADMIN_REQUEST
  PAYMENT_FAILED
  OTHER
}

model Order {
  id Int @id @default(autoincrement())

  // Identification
  orderNumber String @unique

  // Customer
  customerId Int?
  customer   User? @relation(fields: [customerId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  assignedFloristId Int?
  assignedFlorist   Florist? @relation("OrderAssignedFlorist", fields: [assignedFloristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  customerFirstName String
  customerLastName  String?
  customerEmail     String?
  customerPhone     String?

  // Recipient
  recipientFirstName String
  recipientLastName  String?
  recipientPhone     String?

  occasion Occasion?

  // Delivery
  deliveryDate         DateTime
  deliveryTimeSlot     DeliveryTimeSlot
  deliveryInstructions String?

  // Delivery Address (Snapshot)
  deliveryStreet  String
  deliveryStreet2 String?

  deliveryPostalCode  String
  deliveryCity        String
  deliveryDistrict    String
  deliveryCountryCode String @db.Char(2)

  deliveryLatitude  Decimal @db.Decimal(9, 6)
  deliveryLongitude Decimal @db.Decimal(9, 6)

  // Card
  cardMessage String?

  // Internal notes
  notes String?

  // Financials
  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @db.Decimal(10, 2)
  discount    Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(10, 2)

  // Workflow
  status OrderStatus @default(CREATED)

  // Relations
  items  OrderItem[]
  offers OrderOffer[]
  statusHistory OrderStatusHistory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  assignedAt DateTime?

  cancelledAt       DateTime?
  cancellationReason OrderCancellationReason?

  @@index([customerId])
  @@index([status])
  @@index([deliveryDate])
  @@index([deletedAt])
}

model OrderItem {
  id Int @id @default(autoincrement())

  // Order
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Product reference
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Product snapshot
  productName        String
  productDescription String?

  orderOfferItems OrderOfferItem[]

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  fromStatus OrderStatus?
  toStatus   OrderStatus

  changedByUserId Int?
  changedByUser   User? @relation(fields: [changedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  reason String?

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([changedByUserId])
  @@index([createdAt])
}

enum OrderOfferStatus {
  PENDING
  VIEWED
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

model OrderOffer {
  id Int @id @default(autoincrement())

  // Order
  orderId Int
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Florist
  floristId Int
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Snapshot
  compensationAmount Decimal @db.Decimal(10, 2)

  orderOfferItems OrderOfferItem[]

  // Workflow
  status OrderOfferStatus @default(PENDING)

  distanceKm Decimal @db.Decimal(8, 2)

  viewedAt   DateTime?
  acceptedAt DateTime?
  declinedAt DateTime?
  expiresAt  DateTime

  declineReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([floristId])
  @@index([status])
  @@index([expiresAt])
}

model OrderOfferItem {
  id Int @id @default(autoincrement())

  orderOfferId Int
  orderOffer   OrderOffer @relation(fields: [orderOfferId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  orderItemId Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Snapshot
  productId   Int
  productName String

  quantity Int

  unitCompensation  Decimal @db.Decimal(10, 2)
  totalCompensation Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@unique([orderOfferId, orderItemId])
  @@index([orderOfferId])
  @@index([orderItemId])
  @@index([productId])
}

model FloristCompensationRule {
  id Int @id @default(autoincrement())

  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  floristId Int
  florist   Florist @relation(fields: [floristId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  compensationAmount Decimal @db.Decimal(10, 2)

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([productId, floristId])
  @@index([productId])
  @@index([floristId])
  @@index([active])
  @@index([deletedAt])
}
