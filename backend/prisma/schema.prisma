generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          Int      @id @default(autoincrement())

  name        String   @unique
  slug        String   @unique

  description String?

  active      Boolean  @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
  @@index([deletedAt])
}


model Florist {
  id               Int      @id @default(autoincrement())

  name             String
  legalName        String?

  taxNumber        String   @unique

  email            String   @unique
  phone            String

  website          String?
  description      String?

  active           Boolean  @default(true)
  acceptingOrders  Boolean  @default(true)

  deliveryRadiusKm Decimal  @db.Decimal(5,2)

  addressId        Int      @unique
  address          Address  @relation(fields: [addressId], references: [id])

  users            User[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([deletedAt])

  @@index([active])
  @@index([acceptingOrders])
}

enum UserRole {
  SYSTEM_ADMIN
  FLORIST
  CUSTOMER
}

model User {
  id            Int       @id @default(autoincrement())

  firstName     String
  lastName      String

  email         String    @unique
  passwordHash  String

  phone         String?

  avatarUrl     String?

  role          UserRole

  active        Boolean   @default(true)
  emailVerified Boolean   @default(false)

  lastLoginAt   DateTime?

  floristId     Int?
  florist       Florist?  @relation(fields: [floristId], references: [id])

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([role])
  @@index([active])
}

model Address {
  id          Int      @id @default(autoincrement())

  label       String?

  street      String
  street2     String?

  postalCode  String
  city        String
  district    String
  country     String

  latitude    Decimal  @db.Decimal(9,6)
  longitude   Decimal  @db.Decimal(9,6)

  notes       String?

  florist     Florist?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([deletedAt])

  @@index([postalCode])
  @@index([city])
}

enum FileProvider {
  LOCAL
  S3
  AZURE
  CLOUDINARY
}

model File {
  id Int @id @default(autoincrement())

  originalName String

  storedName String

  extension String

  mimeType String

  size Int

  path String

  checksum String? @unique

  width Int?

  height Int?

  altText String?

  provider FileProvider

  uploadedAt DateTime @default(now())
}