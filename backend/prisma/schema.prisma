generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// ENUMS
//

enum UserRole {
  SYSTEM_ADMIN
  FLORIST
  CUSTOMER
}

enum FileProvider {
  LOCAL
  S3
  AZURE
  CLOUDINARY
}

enum ProductPricingType {
  FIXED
  PER_UNIT
}

enum PricingMarginType {
  FIXED_AMOUNT
  PERCENTAGE
  FIXED_PRICE
}

//
// MODELS
//

model Category {
  id Int @id @default(autoincrement())

  name String @unique
  slug String @unique
  description String?

  active Boolean @default(true)

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([active])
  @@index([deletedAt])
}

model Address {
  id Int @id @default(autoincrement())

  label String?

  street String
  street2 String?

  postalCode String
  city String
  district String
  country String

  latitude Decimal @db.Decimal(9,6)
  longitude Decimal @db.Decimal(9,6)

  notes String?

  florist Florist?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([postalCode])
  @@index([city])
  @@index([deletedAt])
}

model Florist {
  id Int @id @default(autoincrement())

  name String
  legalName String?

  taxNumber String @unique

  email String @unique
  phone String

  website String?
  description String?

  active Boolean @default(true)
  acceptingOrders Boolean @default(true)

  deliveryRadiusKm Decimal @db.Decimal(5,2)

  addressId Int @unique
  address Address @relation(fields: [addressId], references: [id])

  users User[]

  products FloristProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([active])
  @@index([acceptingOrders])
  @@index([deletedAt])
}

model User {
  id Int @id @default(autoincrement())

  firstName String
  lastName String

  email String @unique
  passwordHash String

  phone String?

  avatarUrl String?

  role UserRole

  active Boolean @default(true)
  emailVerified Boolean @default(false)

  lastLoginAt DateTime?

  floristId Int?
  florist Florist? @relation(fields: [floristId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([role])
  @@index([active])
  @@index([deletedAt])
}

model File {
  id Int @id @default(autoincrement())

  originalName String
  storedName String

  extension String
  mimeType String

  size Int

  path String

  checksum String? @unique

  width Int?
  height Int?

  altText String?

  provider FileProvider

  uploadedAt DateTime @default(now())
}

model Product {
  id Int @id @default(autoincrement())

  name String
  slug String @unique
  description String?

  active Boolean @default(true)

  pricingType ProductPricingType

  basePrice Decimal @db.Decimal(10,2)

  categoryId Int
  category Category @relation(fields: [categoryId], references: [id])

  floristProducts FloristProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([active])
  @@index([deletedAt])
  @@index([categoryId])
}

model FloristProduct {
  id Int @id @default(autoincrement())

  floristId Int
  florist Florist @relation(fields: [floristId], references: [id])

  productId Int
  product Product @relation(fields: [productId], references: [id])

  enabled Boolean @default(true)

  marginType PricingMarginType

  pricingValue Decimal? @db.Decimal(10,2)

  fixedPrice Decimal? @db.Decimal(10,2)

  priority Int @default(0)

  minimumQuantity Int?
  maximumQuantity Int?
  quantityStep Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([floristId, productId])

  @@index([floristId])
  @@index([productId])
  @@index([enabled])
}